{
  "name": "nat-lib-fi/skosmos",
  "description": "Thesaurus and controlled vocabulary browser using SKOS and SPARQL",
  "type": "project",
  "license": "MIT",
  "version": "2.17-dev",
  "repositories": { 
    "lscache": {
      "type": "package",
      "package": {
        "name": "pamelafox/lscache",
        "version": "1.0.5",
        "source": {
          "url": "https://github.com/pamelafox/lscache.git",
          "type": "git",
          "reference": "1.0.5"
        }
      }
    }
  },
  "require": {
    "sweetrdf/easyrdf": "1.7.*",
    "symfony/polyfill-php80": "1.*",
    "symfony/polyfill-php81": "1.*",
    "twig/twig": "^2.15.3",
    "twig/extensions": "1.5.*",
    "twbs/bootstrap": "5.2.*",
    "punic/punic": "3.5.1",
    "willdurand/negotiation": "3.0.*",
    "ml/json-ld": "1.*",
    "ext-gettext": "*",
    "ext-intl": "*",
    "ext-mbstring": "*",
    "ext-xsl": "*",
    "monolog/monolog": "1.27.*"
  },
  "require-dev": {
    "phpunit/phpunit": "9.5.*",
    "umpirsky/twig-gettext-extractor": "1.3.*",
    "symfony/dom-crawler": "5.4.*",
    "mockery/mockery": "1.5.1"
  },
  "autoload": {
    "classmap": ["controller/", "model/", "model/sparql/"]
  },
  "config": {
    "allow-plugins": {
      "robloach/component-installer": true
    }
  }
}

<header class="container-fluid pb-5 px-5" id="headerbar">
{% if request.vocabid == '' %}
<h2 class="fs-1 fw-bold">Skosmos<h2>
{% else %}
<h2 class="fs-2"><a href="{% if request.vocabid != '' %}{{ request.vocabid  }}/{% endif %}{{ request.lang }}/{% if request.contentLang != request.lang %}?clang={{ request.contentLang }}{% endif %}">{{ request.vocab.title(request.contentLang) }}</a></h2>
{% endif %}
</header>

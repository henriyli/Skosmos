<header class="container-fluid d-flex bg-light py-5 px-5 mb-5" id="headerbar">
{% if request.vocabid == '' %}
<h2 class="fs-1 fw-bold text-decoration-none">Skosmos<h2>
{% else %}
<h2 class="fs-2 fw-bold text-decoration-none"><a class="text-decoration-none" href="{% if request.vocabid != '' %}{{ request.vocabid  }}/{% endif %}{{ request.lang }}/{% if request.contentLang != request.lang %}?clang={{ request.contentLang }}{% endif %}">{{ request.vocab.title(request.contentLang) }}</a></h2>
{% endif %}
</header>
